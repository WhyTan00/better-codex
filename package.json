{
  "name": "better-codex",
  "version": "0.2.0-beta.5",
  "private": false,
  "description": "Run a native Codex workbench on your Mac with Tailscale or authenticated CVM access and project plugins.",
  "author": "whytan",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "demo": "python3 -m http.server 4173 --directory apps/demo",
    "test": "node --test packages/host-cli/test/*.test.mjs packages/harness-contract/test/*.test.mjs",
    "public:scan": "python3 scripts/scan-public-tree.py .",
    "source:prepare": "python3 scripts/prepare-portable-source.py",
    "video:install": "pnpm --dir video install",
    "video:typecheck": "pnpm --dir video typecheck",
    "video:render": "pnpm --dir video render",
    "video:render:zh": "pnpm --dir video render:zh-vertical",
    "host": "node scripts/better-codex.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "test:cvm": "node scripts/test-cvm-proxy.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:renderer": "node scripts/test-renderer.mjs"
  },
  "workspaces": [
    "packages/*",
    "video"
  ]
}

{
  "name": "better-codex",
  "version": "0.1.0",
  "private": false,
  "description": "A native Codex workbench pattern: shared Harness, local-first sync, and custom plugins.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "demo": "python3 -m http.server 4173 --directory apps/demo",
    "test": "node --test packages/harness-contract/test/*.test.mjs",
    "public:scan": "python3 scripts/scan-public-tree.py .",
    "source:prepare": "python3 scripts/prepare-public-source.py --source ${BETTER_CODEX_PRIVATE_WORKBENCH:-../workbench} --destination source",
    "video:install": "pnpm --dir video install",
    "video:typecheck": "pnpm --dir video typecheck",
    "video:render": "pnpm --dir video render"
  },
  "workspaces": [
    "packages/*",
    "video"
  ]
}
